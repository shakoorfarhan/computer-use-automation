{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation system: Claude discovery loop, versioned replay artifacts, and human-in-the-loop escalation, demoed against a mock legacy teller console.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mock-app": "tsx src/mock-app/server.ts",
    "discover": "tsx src/discovery/run.ts",
    "replay": "tsx src/replay/run.ts",
    "operator": "tsx src/escalation/operatorCli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "ejs": "^3.1.10",
    "playwright": "^1.49.1",
    "zod": "^3.24.1",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
