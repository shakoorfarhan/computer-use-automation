<%- include("partials/head", { title: "Login" }) %>
<% if (typeof reason !== "undefined" && reason === "session_expired") { %>
  <div class="error-box" role="alert">Your session has expired. Please sign in again.</div>
<% } %>
<% if (typeof reason !== "undefined" && reason === "invalid") { %>
  <div class="error-box" role="alert">Invalid teller ID or password.</div>
<% } %>
<fieldset>
<legend>Teller Sign In</legend>
<form method="post" action="/login">
  <table class="field-row">
    <tr>
      <td><label for="username">Teller ID</label></td>
      <td><input type="text" id="username" name="username" autocomplete="username"></td>
    </tr>
    <tr>
      <td><label for="password">Password</label></td>
      <td><input type="password" id="password" name="password" autocomplete="current-password"></td>
    </tr>
  </table>
  <button type="submit">Sign In</button>
</form>
</fieldset>
<%- include("partials/foot") %>
