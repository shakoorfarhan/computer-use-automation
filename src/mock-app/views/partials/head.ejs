<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= title %> - Meridian Credit Union Teller Console</title>
<style>
  body { font-family: "Times New Roman", Times, serif; background: #d9d9d9; margin: 0; padding: 0; }
  table.layout { width: 100%; border-collapse: collapse; }
  table.layout > tbody > tr > td.banner { background: #003366; color: #fff; padding: 8px 12px; font-size: 20px; font-weight: bold; }
  table.layout > tbody > tr > td.content { padding: 16px; vertical-align: top; }
  table.data { border: 1px solid #666; border-collapse: collapse; background: #fff; margin-bottom: 12px; }
  table.data caption { text-align: left; font-weight: bold; background: #cccccc; padding: 4px 8px; border: 1px solid #666; }
  table.data th, table.data td { border: 1px solid #999; padding: 4px 10px; font-size: 14px; }
  table.data th { background: #eeeeee; text-align: left; }
  .field-row td { padding: 3px 6px; }
  fieldset { border: 1px solid #999; background: #fff; padding: 10px; }
  .error-box { border: 2px solid #990000; background: #ffe0e0; color: #660000; padding: 10px; margin-bottom: 12px; }
  .notice-box { border: 2px solid #336600; background: #e6ffe0; color: #244d00; padding: 10px; margin-bottom: 12px; }
  a { color: #003366; }
</style>
</head>
<body>
<table class="layout">
<tbody>
<tr><td class="banner">Meridian Credit Union &mdash; Teller Console</td></tr>
<tr><td class="content">
